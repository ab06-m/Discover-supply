# Zoho Inventory MCP — Environment Configuration
# Copy this file to .env and fill in your values

# Zoho OAuth Credentials (from accounts.zoho.com/developerconsole)
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Organization ID (from Settings → Organization Profile, or URL)
ZOHO_ORG_ID=921541531

# Zoho Datacenter (us, eu, in, au, jp, ca, sa)
# US = www.zohoapis.com, EU = www.zohoapis.eu, etc.
ZOHO_DATACENTER=us
